MERGE (ba:BodyArea {id: "ba_hip"}) SET ba.name = "Hip", ba.region = "lower extremity";
MERGE (ba:BodyArea {id: "ba_knee"}) SET ba.name = "Knee", ba.region = "lower extremity";
MERGE (ba:BodyArea {id: "ba_leg"}) SET ba.name = "Leg", ba.region = "lower extremity";
