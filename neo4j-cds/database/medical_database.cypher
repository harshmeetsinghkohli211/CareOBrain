// ==========================================================================
// MedGraph Therapy & Medication Engine — Complete Neo4j Cypher Database Export
// Dialect: Neo4j 5.x / AuraDB / Desktop / cypher-shell
// ==========================================================================

// 1. Uniqueness Constraints
CREATE CONSTRAINT disease_id_unique IF NOT EXISTS FOR (d:Disease) REQUIRE d.id IS UNIQUE;
CREATE CONSTRAINT therapy_id_unique IF NOT EXISTS FOR (t:Therapy) REQUIRE t.id IS UNIQUE;
CREATE CONSTRAINT medication_id_unique IF NOT EXISTS FOR (m:Medication) REQUIRE m.id IS UNIQUE;
CREATE CONSTRAINT symptom_id_unique IF NOT EXISTS FOR (s:Symptom) REQUIRE s.id IS UNIQUE;
CREATE CONSTRAINT bodyarea_id_unique IF NOT EXISTS FOR (ba:BodyArea) REQUIRE ba.id IS UNIQUE;

// 2. Body Areas (30 nodes)
MERGE (ba:BodyArea {id: "ba_head"}) SET ba.name = "Head", ba.region = "cranial";
MERGE (ba:BodyArea {id: "ba_brain"}) SET ba.name = "Brain", ba.region = "cranial";
MERGE (ba:BodyArea {id: "ba_neck"}) SET ba.name = "Neck", ba.region = "cervical";
