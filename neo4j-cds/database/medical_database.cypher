MERGE (ba:BodyArea {id: "ba_blood_vessel"}) SET ba.name = "Blood Vessels", ba.region = "vascular";
MERGE (ba:BodyArea {id: "ba_nerve"}) SET ba.name = "Peripheral Nerves", ba.region = "nervous";
MERGE (ba:BodyArea {id: "ba_muscle"}) SET ba.name = "Muscle Tissue", ba.region = "musculoskeletal";
MERGE (ba:BodyArea {id: "ba_bone"}) SET ba.name = "Bone", ba.region = "musculoskeletal";
MERGE (ba:BodyArea {id: "ba_joint"}) SET ba.name = "Joint", ba.region = "musculoskeletal";
MERGE (ba:BodyArea {id: "ba_eye"}) SET ba.name = "Eye", ba.region = "cranial";
