// 4. Therapies (30 nodes)
MERGE (t:Therapy {id: "th_physio"}) SET t.name = "Physical Therapy", t.type = "physical", t.description = "Exercise-based rehabilitation to restore movement, strength, and function through guided physical exercises, stretching, and progressive resistance training", t.contraindications = "acute fractures, severe cardiac conditions", t.duration = "6-12 weeks", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_hydro"}) SET t.name = "Hydrotherapy", t.type = "physical", t.description = "Water-based therapy using buoyancy and resistance for joint mobilization, pain relief, and muscle strengthening in warm water pools", t.contraindications = "open wounds, urinary infections, severe cardiac disease", t.duration = "4-8 weeks", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_cryo"}) SET t.name = "Cryotherapy", t.type = "physical", t.description = "Cold application therapy to reduce swelling, inflammation, pain, and muscle spasm through ice packs, cold compression, or whole-body cryotherapy", t.contraindications = "Raynaud disease, cold sensitivity, peripheral vascular disease", t.duration = "acute: 48-72 hours", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_heat"}) SET t.name = "Heat Therapy", t.type = "physical", t.description = "Application of heat via hot packs, infrared lamps, or paraffin baths to increase blood flow, relax muscles, reduce stiffness, and relieve chronic pain", t.contraindications = "acute inflammation, hemorrhage, impaired sensation", t.duration = "ongoing as needed", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_tens"}) SET t.name = "TENS Therapy", t.type = "electrotherapy", t.description = "Transcutaneous Electrical Nerve Stimulation using low-voltage electrical currents to block pain signals and stimulate endorphin release", t.contraindications = "pacemaker, pregnancy (abdominal), epilepsy", t.duration = "ongoing sessions", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_ultrasound"}) SET t.name = "Therapeutic Ultrasound", t.type = "electrotherapy", t.description = "Deep tissue heating using sound waves to promote tissue healing, reduce scar tissue, increase blood flow, and decrease inflammation", t.contraindications = "over malignancy, growth plates, eyes, pregnant uterus", t.duration = "4-6 weeks", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_massage"}) SET t.name = "Therapeutic Massage", t.type = "manual", t.description = "Manual manipulation of soft tissues to reduce muscle tension, improve circulation, decrease pain, and promote lymphatic drainage", t.contraindications = "DVT, open wounds, skin infections, fractures", t.duration = "ongoing sessions", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_manual"}) SET t.name = "Manual Therapy / Mobilization", t.type = "manual", t.description = "Hands-on joint mobilization and manipulation to restore range of motion, reduce pain, and improve joint mechanics", t.contraindications = "osteoporosis, fractures, spinal cord compression", t.duration = "4-8 weeks", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_traction"}) SET t.name = "Spinal Traction", t.type = "mechanical", t.description = "Mechanical or manual stretching of the spine to decompress nerve roots, reduce disc herniation pressure, and relieve radiculopathy", t.contraindications = "spinal tumors, osteoporosis, pregnancy, spinal infections", t.duration = "4-6 weeks", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_splint"}) SET t.name = "Splinting / Immobilization", t.type = "mechanical", t.description = "External fixation using splints, braces, or casts to protect injured structures, maintain alignment, and allow healing", t.contraindications = "compartment syndrome risk", t.duration = "2-8 weeks", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_compression"}) SET t.name = "Compression Therapy", t.type = "mechanical", t.description = "Application of graduated compression stockings or bandages to reduce edema, prevent blood clots, and improve venous return", t.contraindications = "peripheral artery disease, skin infection", t.duration = "ongoing", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_elevation"}) SET t.name = "Elevation Therapy", t.type = "positional", t.description = "Elevating the affected limb above heart level to reduce swelling through gravity-assisted venous and lymphatic drainage", t.contraindications = "none significant", t.duration = "acute: 48-72 hours", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_rom"}) SET t.name = "Range of Motion Exercises", t.type = "exercise", t.description = "Active and passive exercises to maintain and restore joint flexibility, prevent contractures, and improve functional mobility", t.contraindications = "unstable fractures, acute inflammation", t.duration = "ongoing", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_strength"}) SET t.name = "Strengthening Exercises", t.type = "exercise", t.description = "Progressive resistance training to rebuild muscle strength, improve stability, and support injured joints through isometric, isotonic, and isokinetic protocols", t.contraindications = "acute injury phase, uncontrolled hypertension", t.duration = "8-16 weeks", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_balance"}) SET t.name = "Balance & Proprioception Training", t.type = "exercise", t.description = "Exercises on unstable surfaces and with perturbation to restore proprioceptive awareness, prevent re-injury, and improve neuromuscular control", t.contraindications = "acute vertigo, severe balance disorders", t.duration = "6-12 weeks", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_occupational"}) SET t.name = "Occupational Therapy", t.type = "rehabilitation", t.description = "Rehabilitation focused on activities of daily living, hand function, adaptive equipment, and workplace ergonomics", t.contraindications = "none significant", t.duration = "8-16 weeks", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_speech"}) SET t.name = "Speech & Swallowing Therapy", t.type = "rehabilitation", t.description = "Therapy for speech, language, cognitive-communication, and swallowing disorders following stroke or neurological injury", t.contraindications = "none significant", t.duration = "12-24 weeks", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_respiratory"}) SET t.name = "Respiratory Therapy", t.type = "respiratory", t.description = "Breathing exercises, chest physiotherapy, incentive spirometry, and airway clearance techniques for pulmonary conditions", t.contraindications = "pneumothorax without chest tube", t.duration = "ongoing", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_wound_care"}) SET t.name = "Wound Care Management", t.type = "wound", t.description = "Systematic wound assessment, debridement, dressing changes, infection control, and promotion of tissue granulation and epithelialization", t.contraindications = "none significant", t.duration = "until healed", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_thrombolysis"}) SET t.name = "Thrombolytic Therapy", t.type = "emergency", t.description = "Administration of clot-dissolving agents to restore blood flow in acute thrombotic events like stroke, pulmonary embolism, and DVT", t.contraindications = "active bleeding, recent surgery, hemorrhagic stroke", t.duration = "acute intervention", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_anticoag"}) SET t.name = "Anticoagulation Therapy", t.type = "pharmacological", t.description = "Blood thinning therapy to prevent and treat blood clots through heparin, warfarin, or direct oral anticoagulants", t.contraindications = "active bleeding, bleeding disorders", t.duration = "3-12 months", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_insulin"}) SET t.name = "Insulin Therapy", t.type = "endocrine", t.description = "Exogenous insulin administration to manage blood glucose levels in diabetes through subcutaneous injection or insulin pump", t.contraindications = "hypoglycemia", t.duration = "lifelong for Type 1, variable for Type 2", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_dialysis"}) SET t.name = "Dialysis Therapy", t.type = "renal", t.description = "Renal replacement therapy using hemodialysis or peritoneal dialysis to filter waste products when kidneys fail", t.contraindications = "hemodynamic instability", t.duration = "ongoing until transplant", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_chemo"}) SET t.name = "Chemotherapy", t.type = "oncology", t.description = "Systemic administration of cytotoxic drugs to destroy rapidly dividing cancer cells through various protocols and cycles", t.contraindications = "severe immunosuppression, organ failure", t.duration = "multiple cycles", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_radiation"}) SET t.name = "Radiation Therapy", t.type = "oncology", t.description = "Targeted high-energy radiation beams to destroy cancer cells and shrink tumors while minimizing damage to surrounding tissue", t.contraindications = "pregnancy, prior radiation to same area", t.duration = "5-7 weeks typically", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_cbt"}) SET t.name = "Cognitive Behavioral Therapy", t.type = "psychological", t.description = "Psychological therapy for chronic pain management, addressing pain catastrophizing, fear avoidance, and developing coping strategies", t.contraindications = "acute psychosis", t.duration = "8-16 sessions", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_acupuncture"}) SET t.name = "Acupuncture", t.type = "complementary", t.description = "Insertion of fine needles at specific points to modulate pain pathways, reduce inflammation, and promote natural healing", t.contraindications = "bleeding disorders, anticoagulant therapy", t.duration = "6-12 sessions", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_laser"}) SET t.name = "Low-Level Laser Therapy", t.type = "electrotherapy", t.description = "Application of low-intensity laser light to stimulate cellular repair, reduce inflammation, and accelerate tissue healing", t.contraindications = "over malignancy, eyes, pregnancy", t.duration = "6-12 sessions", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_shockwave"}) SET t.name = "Extracorporeal Shockwave Therapy", t.type = "mechanical", t.description = "High-energy acoustic waves directed at chronic tendinopathy to stimulate neovascularization and tissue remodeling", t.contraindications = "over nerves, blood vessels, lung tissue, growth plates", t.duration = "3-6 sessions", t.evidence_level = "A";
MERGE (t:Therapy {id: "th_lymphatic"}) SET t.name = "Manual Lymphatic Drainage", t.type = "manual", t.description = "Gentle massage technique to stimulate lymphatic flow, reduce lymphedema, and decrease post-surgical swelling", t.contraindications = "active infection, DVT, cardiac failure", t.duration = "ongoing as needed", t.evidence_level = "A";

// 5. Medications (50+ nodes)
MERGE (m:Medication {id: "med_ibuprofen"}) SET m.name = "Ibuprofen", m.description = "Non-steroidal anti-inflammatory drug for pain, inflammation, swelling, and fever reduction", m.dosage = "200-800mg", m.form = "oral tablet", m.frequency = "every 6-8 hours", m.contraindications = "GI ulcers, renal impairment, aspirin allergy";
