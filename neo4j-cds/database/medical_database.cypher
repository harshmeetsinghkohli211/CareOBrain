MERGE (m:Medication {id: "med_tramadol"}) SET m.name = "Tramadol", m.description = "Centrally acting opioid analgesic for moderate to severe pain with lower abuse potential than strong opioids", m.dosage = "50-100mg", m.form = "oral tablet", m.frequency = "every 4-6 hours", m.contraindications = "seizure disorders, MAO inhibitors, respiratory depression";
MERGE (m:Medication {id: "med_gabapentin"}) SET m.name = "Gabapentin", m.description = "Anticonvulsant used for neuropathic pain, nerve damage pain, post-herpetic neuralgia, and diabetic neuropathy", m.dosage = "300-3600mg/day", m.form = "oral capsule", m.frequency = "three times daily", m.contraindications = "renal impairment (dose adjustment)";
MERGE (m:Medication {id: "med_pregabalin"}) SET m.name = "Pregabalin", m.description = "Anticonvulsant for neuropathic pain, fibromyalgia, and generalized anxiety with nerve pain component", m.dosage = "75-300mg", m.form = "oral capsule", m.frequency = "twice daily", m.contraindications = "renal impairment, angioedema history";
MERGE (m:Medication {id: "med_prednisone"}) SET m.name = "Prednisone", m.description = "Oral corticosteroid for severe inflammation, autoimmune conditions, allergic reactions, and flare management", m.dosage = "5-60mg", m.form = "oral tablet", m.frequency = "once daily (with taper)", m.contraindications = "systemic fungal infections, live vaccines";
MERGE (m:Medication {id: "med_methylpred"}) SET m.name = "Methylprednisolone", m.description = "Potent corticosteroid for acute inflammatory conditions, spinal cord injury, severe allergic reactions, and joint injections", m.dosage = "4-48mg oral / 40-120mg injection", m.form = "oral / injection", m.frequency = "varies by indication", m.contraindications = "systemic infections, GI perforation";
MERGE (m:Medication {id: "med_cortisone_inj"}) SET m.name = "Cortisone Injection", m.description = "Local corticosteroid injection directly into joints or soft tissues for targeted inflammation and pain relief", m.dosage = "25-50mg per injection", m.form = "intra-articular injection", m.frequency = "every 3-6 months max", m.contraindications = "joint infection, bleeding disorders";
MERGE (m:Medication {id: "med_cyclobenzaprine"}) SET m.name = "Cyclobenzaprine", m.description = "Skeletal muscle relaxant for acute muscle spasm, strain-related pain, and musculoskeletal spasticity", m.dosage = "5-10mg", m.form = "oral tablet", m.frequency = "three times daily", m.contraindications = "MAO inhibitors, cardiac arrhythmias, hyperthyroidism";
MERGE (m:Medication {id: "med_baclofen"}) SET m.name = "Baclofen", m.description = "GABA-B agonist muscle relaxant for spasticity from spinal cord injury, multiple sclerosis, and cerebral palsy", m.dosage = "5-20mg", m.form = "oral tablet", m.frequency = "three times daily", m.contraindications = "epilepsy (caution), renal impairment";
MERGE (m:Medication {id: "med_tizanidine"}) SET m.name = "Tizanidine", m.description = "Alpha-2 adrenergic agonist for muscle spasticity and associated pain in multiple sclerosis and spinal cord injury", m.dosage = "2-8mg", m.form = "oral tablet", m.frequency = "every 6-8 hours", m.contraindications = "hepatic impairment, concurrent CYP1A2 inhibitors";
